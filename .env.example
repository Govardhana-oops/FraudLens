# ==============================================================================
# FraudLens / AI-DIDSS: Environment Configuration Example
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. REQUIRED (Render FastAPI Backend)
# ------------------------------------------------------------------------------
# Port for the FastAPI server (Render automatically sets this in production)
PORT=8000

# ------------------------------------------------------------------------------
# 2. PRODUCTION CORS (Render Backend -> Vercel Frontend)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins for CORS.
# For local development: http://localhost:5173,http://localhost:5174
# For production: https://<your-vercel-app-name>.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ------------------------------------------------------------------------------
# 3. OPTIONAL / DEEP LEARNING CACHE PATHS (Render Container)
# ------------------------------------------------------------------------------
TORCH_HOME=/tmp/.cache/torch
EASYOCR_MODULE_PATH=/tmp/.EasyOCR
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# ------------------------------------------------------------------------------
# 4. REQUIRED (Vercel React Frontend)
# Set this in Vercel Project Settings -> Environment Variables
# ------------------------------------------------------------------------------
# Local Development: http://localhost:8000
# Production: https://<your-render-service-name>.onrender.com
VITE_API_BASE_URL=http://localhost:8000
