{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "destination": "/module9_officer_console/index.html"
    },
    {
      "source": "/index.css",
      "destination": "/module9_officer_console/index.css"
    },
    {
      "source": "/app.js",
      "destination": "/module9_officer_console/app.js"
    },
    {
      "source": "/console",
      "destination": "/module9_officer_console/index.html"
    },
    {
      "source": "/console/(.*)",
      "destination": "/module9_officer_console/$1"
    }
  ]
}
