{
  "version": 2,
  "buildCommand": "node build-vercel.js",
  "installCommand": "node install-vercel.js",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
