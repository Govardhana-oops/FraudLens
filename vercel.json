{
  "version": 2,
  "cleanUrls": true,
  "buildCommand": "cd fraudlens-new-frontend && npm install && npm run build",
  "outputDirectory": "fraudlens-new-frontend/dist",
  "installCommand": "cd fraudlens-new-frontend && npm install",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
