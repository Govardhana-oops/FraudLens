{
  "version": 2,
  "cleanUrls": true,
  "buildCommand": "npm --prefix fraudlens-new-frontend run build",
  "outputDirectory": "fraudlens-new-frontend/dist",
  "installCommand": "npm --prefix fraudlens-new-frontend install",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
